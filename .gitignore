# ==========================================
# Dependencias (lo más pesado que nunca se debe subir)
# ==========================================
node_modules/
*/node_modules/
package-lock.json.bak

# ==========================================
# Compilados y builds (Angular & NestJS)
# ==========================================
dist/
*/dist/
out-tsc/
*/out-tsc/
.angular/
*/.angular/

# ==========================================
# Archivos de registro y depuración (Logs)
# ==========================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# Variables de entorno y llaves secretas
# ==========================================
.env
.env.*
!.env.example

# ==========================================
# Basura del Sistema Operativo (Windows / Mac / Linux)
# ==========================================
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride

# ==========================================
# Archivos temporales de Editores e IDEs
# ==========================================
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

